<style>
#settings_mail_from {
  display: none;
}

.mail-from-item {
  display: block;
}

.mail-from-val {
  margin-right: .5em;
}

span.mail-from-handle,
a.mail-from-edit,
a.mail-from-delete {
  opacity: 0.4;
}

span.mail-from-handle:hover,
a.mail-from-edit:hover,
a.mail-from-delete:hover {
  opacity: 1;
}

#mail-from-add {
  display: block;
  padding-top: .25em;
}
</style>

<script type="text/javascript">
//<![CDATA[
$(function() {
  // Redmine 6 renders icons as an SVG sprite. The CSS classes alone no longer
  // produce a visible icon: .icon and .icon-only are display:inline-flex
  // without padding or size, so the .icon-edit:not(:has(svg)) fallback to
  // edit.png has no box to paint on. Build the sprite markup server side.
  var icons = {
    add:    '<%= escape_javascript sprite_icon('add') %>',
    edit:   '<%= escape_javascript sprite_icon('edit') %>',
    del:    '<%= escape_javascript sprite_icon('del') %>',
    handle: '<%= escape_javascript sprite_icon('reorder', '') %>'
  };

  var input = function(val) {
    var text = '<%= escape_javascript l(:setting_mail_from) %>\n' +
        '(%f: <%= escape_javascript l(:field_firstname) %>, %l: <%= escape_javascript l(:field_lastname) %>, %m: <%= escape_javascript l(:field_mail) %>, %u: <%= escape_javascript l(:field_login) %>)';

    return window.prompt(text, val);
  };

  var append = function(val) {
    var content = '<span class="mail-from-item">' +
        '<input type="checkbox" checked disabled>' +
        '<span class="mail-from-val">' +
        $('<span>').text(val).html() +
        '</span>' + ' ' +
        '<span class="icon-only icon-sort-handle sort-handle mail-from-handle" title="<%= escape_javascript l(:button_sort) %>">' +
        icons.handle + '</span>' + ' ' +
        '<a class="icon-only icon-edit mail-from-edit" href="#">' +
        icons.edit + '</a>' + ' ' +
        '<a class="icon-only icon-del mail-from-delete" href="#">' +
        icons.del + '</a>' +
        '</span>';

    $('#mail-from-list').append(content);
  };

  var update = function() {
    var item = [];

    $('#mail-from-list span.mail-from-val').each(function(index) {
      item.push($(this).text());
    });

    $('#settings_mail_from').val(item.join(' :: '));
  };

  var field = $('#settings_mail_from');
  if (field.length === 0) { return; }

  var mailFromContent = '<span id="mail-from-list"></span>' +
      '<span id="mail-from-add">' +
      '<a class="icon icon-add" href="#">' + icons.add +
      '<span class="icon-label"><%= escape_javascript l(:label_email_address_add) %></span>' +
      '</a></span>' +
      '<em class="info">%p: <%= escape_javascript l(:field_project) %>,&ensp;%f: <%= escape_javascript l(:field_firstname) %>,&ensp; %l: <%= escape_javascript l(:field_lastname) %>,&ensp;%m: <%= escape_javascript l(:field_mail) %>,&ensp;%u: <%= escape_javascript l(:field_login) %></em>';

  field.after(mailFromContent);

  (field.val() || '').split(/\s*::\s*/).forEach(function(val) {
    if (val) append(val);
  });

  $('#mail-from-add a').on('click', function(e) {
    e.preventDefault();

    var val = input('');

    if (val) {
      append(val);
      update();
    }
  });

  $('#mail-from-list').on('click', 'a.mail-from-edit', function(e) {
    e.preventDefault();

    var item = $(e.currentTarget).parent().children('span.mail-from-val');

    var val = input(item.text());

    if (val) {
      item.text(val);
      update();
    }
  });

  $('#mail-from-list').on('click', 'a.mail-from-delete', function(e) {
    e.preventDefault();

    $(e.currentTarget).parent().remove();
    update();
  });

  $('#mail-from-list').sortable({
    axis: 'y',
    handle: '.mail-from-handle',
    update: update
  });
});
//]]>
</script>
